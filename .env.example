# Configurações do Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:3333/api/auth/google/callback"

# Banco de Dados SQLite (relativo ao schema.prisma em /prisma ou absoluto)
DATABASE_URL="file:../data/app.db"

# Portas dos Serviços Locais
API_PORT=3333
WEB_PORT=5173

# Regras de Negócio e Agendamento Padrão
DEFAULT_TIMEZONE="America/Recife"
DEFAULT_MINIMUM_LEAD_MINUTES=10
